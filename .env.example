# ==========================================
# VidRAG Environment Configuration
# ==========================================

# Groq API Key (LLM Inference & Whisper Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# TiDB Cloud Serverless Connection String (Single URL)
TIDB_DATABASE_URL="mysql://<user>:<password>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/youtube_rag"

# JWT Secret for User Authentication
JWT_SECRET=your_super_secret_jwt_key_vidrag_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth Client ID (Optional for Google Sign-In)
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Embedding & RAG Parameters
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
